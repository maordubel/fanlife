    "lines": [
      {
        "shot": 2,
        "offset": 0.5,
        "text": "Saturday, the twenty-first of September. The road to Sarajevo runs through the mountains, and it takes its time."
      },
      {
        "shot": 3,
        "offset": 1.0,
        "text": "Nobody minds. A trip like this is half the match."
      },
      {
        "shot": 4,
        "offset": 1.0,
        "text": "Down the stone steps, and into the city."
      },
      {
        "shot": 6,
        "offset": 1.0,
        "text": "Grbavica. Home of Željezničar."
      },
      {
        "shot": 7,
        "offset": 0.6,
        "text": "Round seven of the Premier League of Bosnia and Herzegovina. Željezničar against Zrinjski Mostar, and around thirteen and a half thousand inside."
      },
      {
        "shot": 9,
        "offset": 0.6,
        "text": "Then one end turns red."
      },
      {
        "shot": 10,
        "offset": 3.0,
        "text": "And the other answers in blue."
      },
      {
        "shot": 12,
        "offset": 3.2,
        "text": "Sixty-six minutes in, Nardin Mulahusejnović scored for Zrinjski. In stoppage time, Marijan Ćavar made it two."
      },
      {
        "shot": 13,
        "offset": 1.5,
        "text": "Were you there? Stamp your ticket on FAN LIFE."
      }
    ]
  },
