/**
 * The 30-day plan (owner, 24.11.2026: "marketing has failed so far — a new, focused plan for the next 30 days: the site, the
 * shop, YouTube; every club on its own, every product on its own, the sales, Black Friday, YouTube, Legends Manager,
 * Royal Rumble, the market, the kit archive"). Research and reasoning: the project doc claude/marketing-30-day-plan-2026-11-24.md.
 *
 * Everything is a campaign of lib/marketing/campaigns.ts, so the control room's Campaigns area reports, pauses and stops
 * every part of it. Writes supabase/marketing/0011_marketing_campaigns_m30.sql: the old plan's posts still ahead in the
 * window are SKIPPED (kept, never deleted — the sent history and the live slots stay as they are), then the campaigns go in.
 * Run: node --import tsx scripts/marketing/plan-m30.mts
 */
import {writeFileSync} from 'node:fs'
import {buildCampaign, type CampaignInput} from '../../lib/marketing/campaigns'

const FROM = '2026-11-25', TO = '2026-12-24'
// one club owns three days: its card in the morning, its products at noon, a game in the afternoon, its film at night
const ROTATION = ['panathinaikos', 'olympiacos', 'aek-athens', 'celtic', 'zrinjski-mostar', 'hapoel-tel-aviv', 'st-pauli', 'atalanta', 'hapoel-petah-tikva', 'raja-casablanca']
const addDays = (d: string, k: number) => new Date(Date.parse(`${d}T12:00:00Z`) + k * 864e5).toISOString().slice(0, 10)

export const M30: CampaignInput[] = [
  ...ROTATION.map((club, i) => ({template: 'club-days' as const, club, start: addDays(FROM, i * 3), days: 3, id: `m30-club-${club}`, name: `30 days · ${club} days`})),
  // Football Fairy Tales on the club's own days, in its language: Good Morning on its first morning, Good Night the next night
  ...['panathinaikos', 'olympiacos', 'aek-athens', 'celtic', 'hapoel-tel-aviv'].map(club => ({template: 'fairy-tales' as const, club, start: addDays(FROM, ROTATION.indexOf(club) * 3), days: 2, id: `m30-tales-${club}`, name: `Fairy Tales · ${club}`})),
  // Black Friday (saved in the shop: −30% Fri 27 – Mon 30 Nov): the day before, every day of it, twice on the last
  {template: 'sale-beats', start: '2026-11-26', days: 5, clubs: ['panathinaikos', 'olympiacos', 'olympiacos', 'olympiacos', 'aek-athens'], id: 'm30-black-friday', name: 'Black Friday 2026',
    sale: {label: 'Black Friday', percent: 30, ends: 'Mon 30 Nov', starts: '2026-11-27'}, times: ['08:31', '21:13']},
  // the clubs that opened without a launch (Atalanta, Raja) get their opening week now
  {template: 'club-opening', club: 'atalanta', start: '2026-11-25', days: 3, opened: true, id: 'm30-open-atalanta', name: 'New club · Atalanta', times: ['19:47', '15:17']},
  {template: 'club-opening', club: 'raja-casablanca', start: '2026-11-26', days: 3, opened: true, id: 'm30-open-raja-casablanca', name: 'New club · Raja Casablanca', times: ['19:57', '15:37']},
  // Fenerbahçe and Partizan open this week (owner): two teaser evenings now; opening night and the week after wait for the club
  {template: 'club-opening', club: 'fenerbahce', start: '2026-11-25', days: 6, id: 'm30-open-fenerbahce', name: 'New club · Fenerbahçe', times: ['19:12', '15:17']},
  // THE ALBUM: the launch code FANLIFE99 (3 envelopes on top of the daily one, until 31 Dec), a club wing, the daily envelope
  {template: 'album-push', start: FROM, days: 30, code: 'FANLIFE99', id: 'm30-album', name: 'The Album · FANLIFE99 launch', times: ['11:07']},
  // the research's best YouTube performers were the atmosphere films: Friday and Saturday nights
  {template: 'film-push', start: FROM, days: 30, playlist: 'ultras', id: 'm30-ultras-nights', name: 'Ultras nights · YouTube', times: ['22:07']},
  {template: 'club-opening', club: 'partizan-belgrade', start: '2026-11-25', days: 6, id: 'm30-open-partizan-belgrade', name: 'New club · Partizan Belgrade', times: ['19:32', '15:37']},
]

if (import.meta.url === `file://${process.argv[1]}`) {
  const built = M30.map(buildCampaign)
  // Black Friday days: the club's noon product post gives way to the sale post (one shop message a day, not two)
  const bfDays = new Set(['2026-11-27', '2026-11-28', '2026-11-29', '2026-11-30'])
  // ultras nights: Fridays and Saturdays only
  for (const b of built) if (b.campaign.id === 'm30-ultras-nights') b.rows = b.rows.filter(r => [5, 6].includes(new Date(`${r.at.slice(0, 10)}T12:00:00Z`).getUTCDay()))
  for (const b of built) if (b.campaign.template === 'club-days') b.rows = b.rows.filter(r => !(bfDays.has(r.at.slice(0, 10)) && r.main.kit.t === 'L-SHOP'))
  const sq = (s: string) => s.replace(/'/g, "''")
  const lines = [
    `-- generated by scripts/marketing/plan-m30.mts — do not edit by hand. The 30-day plan, ${FROM} to ${TO} (owner, 24.11.2026), Athens time.`,
    '-- Needs migration 20261124050000_worker_marketing_campaigns.sql. Re-running adds nothing twice: each campaign is replaced whole.',
    'begin;',
    `-- the old plan's posts ahead in the window are skipped, not deleted; the live slots (results, fixtures, the channel pulse) stay`,
    `update marketing.posts set status = 'skipped', error = 'replaced by the 30-day plan' where status = 'pending' and not main ? 'campaign' and day > 0`,
    `   and (kind = 'fixed' or kind in ('dubid', 'offsides')) and send_at > now() and send_at < (timestamp '${addDays(TO, 1)} 00:00') at time zone 'Europe/Athens';`,
    `delete from marketing.posts where main->'campaign'->>'id' like 'm30-%' and status in ('pending', 'skipped') and send_at > now();`,
  ]
  let total = 0
  for (const b of built) { total += b.rows.length; lines.push(`select public.worker_marketing_campaign_add('${sq(JSON.stringify(b.rows))}'::jsonb); -- ${b.campaign.id}: ${b.rows.length} post(s)`) }
  lines.push('commit;', '')
  writeFileSync('supabase/marketing/0011_marketing_campaigns_m30.sql', lines.join('\n'))
  writeFileSync('scripts/marketing/plan-m30.json', JSON.stringify(built.map(b => ({...b.campaign, rows: b.rows.map(r => ({at: r.at, t: r.main.kit.t, label: r.main.label, held: !!r.held, hook: r.main.hook}))})), null, 1))
  console.log(`${built.length} campaigns, ${total} posts`)
}
