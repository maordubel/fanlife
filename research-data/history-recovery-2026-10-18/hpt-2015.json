  {
   "id": 2650,
   "seasonId": 2015,
   "competition": "ליגה",
   "competitionType": 1,
   "round": "18",
   "day": 17,
   "month": 1,
   "year": 2015,
   "date": 1421506800,
   "opponent": "מ.ס אשדוד",
   "hapoelGoals": 1,
   "opponentGoals": 2,
   "locationType": 1,
   "stadium": "ראש הזהב",
   "crowd": 3000,
   "referee": "צביקה לוי",
   "story": "הפועל פ\"ת המשיכה ברצף משחקי הליגה ללא ניצחון - כבר שישה כאלו - והפעם מול אשדוד זה היה מתסכל במיוחד. קאלה דרשלר ספג בדקה ה-14 שער באשמתו הישירה, כשהשמיט נגיחה של יאיא פטי מכדור חופשי. אוהדי הפועל, מתוסכלים ממספר השערים הרב שספגה העונה הקבוצה באשמת השוער הותיק, החלו לשרוק בוז בכל נגיעה שלו בכדור.\n\nבמחצית השנייה יצאה הפועל קדימה, והאשדודים ניצלו זאת כדי לצאת למתפרצות מסוכנות, ודווקא דרשלר היה זה שהציל את הפועל מספיגת שערים נוספים, כשהדף לא פחות מארבע בעיטות של שחקני אשדוד ממצבים קורצים.\nבדקה ה-70 הצליחה הפועל להשוות - עומרי אלטמן הותיר את דור חוגי לבד מול השוער, וחוגי דייק עם כדור לרשת - שער שני השבוע לחוגי, שנכנס כמחליף במחצית, ו-1:1.\n\nהפועל ניסתה להכריע את המשחק, אבל במקום ה-90 הגיעה סיומת אכזרית ובלתי צפויה - מיכאל אוחנה פרץ היטב לרחבה ושיגר כדור חזק למשקוף ופנימה. 1:2 לאשדוד, ועוד שבוע מתחת לקו האדום.",
   "remark": "",
   "leg": null,
   "position": 13,
   "hapoelPenaltyGoals": null,
   "opponentPenaltyGoals": null,
   "opponentCrestKey": "$2c:props:children:0:props:children:0:0:props:games:4:opponentCrestKey"
  },
  {
   "id": 2660,
