NEXT_PUBLIC_FAN_LIFE_EVALUATION=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# production: NEXT_PUBLIC_SITE_URL=https://fanlife.dubelteam.com
# club hosts: <sub>.FANLIFE_ROOT_DOMAIN (default fanlife.dubelteam.com)
# FANLIFE_ROOT_DOMAIN=fanlife.dubelteam.com
FAN_LIFE_DATA_DIR=.fan-life
CRON_SECRET=
# Owner key for the control room (/master/admin, /master/core, /master/test-lab, /kits/admin, /qa/stats
# and /api/master/*). At least 16 characters. Production with no key = the admin is CLOSED.
# Local development with no key = open, as before. Changing it signs every session out.
FAN_LIFE_ADMIN_KEY=
GITHUB_READ_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
