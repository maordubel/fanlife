{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "npm run build",
  "ignoreCommand": "node scripts/vercel/should-build.mjs",
  "git": {
    "deploymentEnabled": {
      "claude/*": false,
      "dependabot/*": false
    }
  }
}
